[Unit]
Description=MediaMTX (RTSP ingest / WebRTC egress for the CCTV dashboard)
After=network.target

[Service]
Type=simple
User=system
WorkingDirectory=/home/system/EMS/mediamtx
ExecStart=/home/system/EMS/mediamtx/mediamtx /home/system/EMS/mediamtx/mediamtx.yml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
